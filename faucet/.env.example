# ─────────────────────────────────────────────────────────────────────────────
# Lunes Testnet Faucet — environment
# "dev" = NODE_ENV=development|test. Unset NODE_ENV is treated as NON-dev.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
FAUCET_PORT=3333
LUNES_WS_URL=ws://lunes-testnet-node:9944

# Treasury account that funds the faucet (mnemonic or URI). REQUIRED outside dev.
# Fund it manually / from the treasury; the faucet no longer pulls from //Alice.
# Well-known dev seeds (//Alice, the dev phrase, ...) are refused in production.
# In dev, when unset, //Alice is used (local devnet only).
FAUCET_SEED=

# Cloudflare Turnstile. TURNSTILE_SECRET is REQUIRED outside dev (captcha may
# only be skipped in dev). TURNSTILE_SITE_KEY is public (shown in the web UI and
# returned by GET /faucet/config; the DEX uses REACT_APP_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# Express `trust proxy`. Unset/false = ignore X-Forwarded-For (req.ip = socket).
# Behind nginx set the hop count (1) or the proxy address/CIDR
# (e.g. "loopback" or "172.16.0.0/12"). "true" is refused outside dev (spoofable).
TRUST_PROXY=

# Persistent cooldowns/counters. Without it they live in memory (reset on restart).
REDIS_URL=
FAUCET_REDIS_PREFIX=faucet:

# Allowed CORS origins for POST /faucet (comma-separated, "*" = any).
FAUCET_CORS_ORIGINS=*

# Native LUNES per drip, in base units (8 decimals). 1000000000000 = 10,000 LUNES.
FAUCET_DRIP_AMOUNT=1000000000000

# Limits
# per address
FAUCET_COOLDOWN_MINUTES=300
# drips per IP per window (1 = pure IP cooldown)
FAUCET_IP_MAX_PER_WINDOW=3
FAUCET_IP_WINDOW_MINUTES=1440
# global drips per UTC day — size it for N testers
FAUCET_DAILY_LIMIT=50
# HTTP requests per IP per minute
FAUCET_GLOBAL_RATE_PER_MINUTE=20
# wait for isFinalized before answering 202 pending
FAUCET_FINALIZE_TIMEOUT_MS=120000

# PSP22 test tokens dripped together with LUNES (atomic utility.batchAll).
# A token is dripped only when its address is set. Amounts are human units.
# Decimals default to the DEX token registry (LUSDT 6, others 8).
FAUCET_TOKENS=LUSDT,LBTC,LETH,GMC,LUP
FAUCET_TOKEN_LUSDT_ADDRESS=
FAUCET_TOKEN_LUSDT_AMOUNT=1000
FAUCET_TOKEN_LBTC_ADDRESS=
FAUCET_TOKEN_LBTC_AMOUNT=0.05
FAUCET_TOKEN_LETH_ADDRESS=
FAUCET_TOKEN_LETH_AMOUNT=1
FAUCET_TOKEN_GMC_ADDRESS=
FAUCET_TOKEN_GMC_AMOUNT=1000
FAUCET_TOKEN_LUP_ADDRESS=
FAUCET_TOKEN_LUP_AMOUNT=1000
# FAUCET_TOKEN_<SYMBOL>_DECIMALS=8

# Shown in the faucet web UI
FAUCET_PUBLIC_WSS=wss://sandbox.lunes.io/ws
FAUCET_PUBLIC_RPC=https://sandbox.lunes.io
