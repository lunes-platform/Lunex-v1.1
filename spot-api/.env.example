# Database (⚠️ change credentials for production!)
DATABASE_URL="postgresql://user:password@localhost:5432/lunex_spot?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Security
# Desktop app (lunes-dex-desktop) requests carry Origin "app://lunex":
# add it here when the desktop build should talk to this API, e.g.
# CORS_ALLOWED_ORIGINS="https://lunex.io,app://lunex"
CORS_ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3000"
# NODE_ENV must be exactly development | test | production. Any other value
# ("prod", "staging", …) is treated as production AND refuses to boot.
#
# Reverse-proxy trust (Express req.ip + WebSocket per-IP limits). REQUIRED in
# production. Values: false (no proxy; X-Forwarded-For ignored), a hop count
# ("1" = nginx, "2" = Cloudflare → nginx; legacy "true" = 1), or a list of
# trusted proxy IPs/CIDRs/keywords ("loopback,10.0.0.0/8").
TRUST_PROXY=false
# Canonical public https origin of this API. REQUIRED in production: the
# HTTPS redirect targets it instead of the client-supplied Host header.
# PUBLIC_API_ORIGIN="https://api.lunex.io"
PUBLIC_API_ORIGIN=""

# Signed-message binding (anti cross-deployment replay). Every lunex-auth /
# lunex-order-v3 signature carries domain + chain genesis; the API only
# accepts its own. REQUIRED in production. Must match the DEX build
# (REACT_APP_SIGNING_DOMAIN / REACT_APP_LUNES_GENESIS_HASH) and SDK/MCP config.
# Dev default domain: localhost. Genesis: 0x + 64 hex (api.genesisHash.toHex()).
SIGNING_DOMAIN="localhost"
LUNES_GENESIS_HASH=""
# Accept the deprecated unbound formats (lunex-auth without domain/chain,
# lunex-order-v2/v1). Default: false in production, true elsewhere. Enable in
# production only during the announced deprecation window.
# SIGNING_ACCEPT_LEGACY=false

# WebSocket
WS_PORT=4001
# Required in production. Comma-separated browser origins allowed to open WS.
# Include "app://lunex" to allow the Lunex desktop app (lunes-dex-desktop).
ALLOWED_WS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
ORDER_RATE_LIMIT_MAX=10

# Blockchain (Lunes Node)
LUNES_WS_URL="ws://127.0.0.1:9944"
SPOT_CONTRACT_ADDRESS=""
SPOT_CONTRACT_METADATA_PATH="./abis/Spot.json"

# Social analytics pipeline
SOCIAL_ANALYTICS_ENABLED=false
SOCIAL_ANALYTICS_CHAIN_NAME="lunes"
SOCIAL_ANALYTICS_START_BLOCK=0
SOCIAL_ANALYTICS_BACKFILL_BLOCKS=2000
SOCIAL_ANALYTICS_POLL_INTERVAL_MS=15000
SOCIAL_ANALYTICS_MAX_BLOCKS_PER_RUN=100
SOCIAL_ANALYTICS_TRACKED_PALLETS="router,factory,pair,market,orders,copytrade,social"
SOCIAL_ANALYTICS_TRACKED_METHODS="swapexecuted,liquidityadded,liquidityremoved,tradeopened,tradeclosed,deposit,withdraw"

# SubQuery Indexer (recommended — faster and more reliable than direct RPC polling)
# When set, socialIndexerService uses SubQuery GraphQL as primary event source.
# Leave empty to fall back to direct Polkadot.js RPC polling (legacy mode).
SUBQUERY_ENDPOINT=""
# SUBQUERY_ENDPOINT="http://localhost:3000"     # local docker
# SUBQUERY_ENDPOINT="https://subquery.lunex.io" # production
SUBQUERY_ENABLED=true
SUBQUERY_CHAIN_ID=""    # output of: subkey inspect --network substrate (genesis hash)

# Relayer private key (for submitting settlements on-chain)
RELAYER_SEED=""

# Independent ECDSA attestor seed (ADR-001 option c): 32-byte secp256k1 seed
# (0x + 64 hex). Signs blake2_256 of the canonical v2 order message; the
# contract recovers the pubkey and compares with the on-chain attestor_pubkey.
# MUST live on a separate host/secret from RELAYER_SEED in production (2-of-2).
# REQUIRED in production; boot is refused if empty, a dev key, or equal to
# RELAYER_SEED.
ATTESTOR_SEED=""

# Master-switch for on-chain settlement. OFF unless explicitly "true".
# A fully-configured deployment still keeps settlement disarmed until this is set.
SETTLEMENT_ENABLED="false"

# Max settle_trade extrinsics kept in flight at once (settlement pipeline).
# settleTrades submits up to this many concurrently with distinct relayer
# nonces instead of one-per-finalized-block (~5s). Clamped to [1, 64]. Default 8.
MAX_SETTLE_CONCURRENCY="8"

# Bridge admin private key (required for asset bridge process; no dev fallback)
BRIDGE_ADMIN_SEED=""
# Max mint/confirm/payout items the bridge handles inline per finalized block
# (and per kind per retry pass); the excess stays PENDING for the retry, which
# also runs while the relayer is catching up. Integer >= 1. Default 20.
# A per-asset minimum deposit is set with "minDepositAmount" (base units,
# decimal string) on each BRIDGE_ASSETS entry; smaller deposits are recorded
# as MANUAL and never minted automatically. Default: no minimum.
BRIDGE_MAX_INLINE_PER_BLOCK="20"

# Redis (replay protection nonce store + cache)
# In production this points to the Redis container
REDIS_URL="redis://127.0.0.1:6379"
# TTL in seconds for replay-protection nonces. Clamped to >= 600 s (2 × the
# ±5 min signature window) so a nonce never expires while its signature is
# still valid; values below 600 are ignored.
NONCE_TTL_SECONDS=600
# Distributed matching lock. Production must use shared Redis so multiple API
# replicas cannot process independent in-memory books.
MATCHING_LOCK_TTL_MS=30000
MATCHING_LOCK_WAIT_MS=2000
MATCHING_LOCK_RETRY_MS=50

# Vault Reconciliation
# Set to "true" to enable the periodic job that detects and repairs DB drift
VAULT_RECONCILIATION_ENABLED=false
VAULT_RECONCILIATION_INTERVAL_MS=60000

# Structured Logging (pino)
# Levels: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Admin secret (required for pair registration and other admin routes)
# Generate with: openssl rand -base64 32
ADMIN_SECRET=""

# HMAC secret for one-signature READ sessions (POST /api/v1/auth/session).
# Required in production (>= 32 chars, must differ from ADMIN_SECRET).
# Dev: leave empty to use a random per-process secret.
# Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Contract addresses (fill after deployment)
FACTORY_CONTRACT_ADDRESS=""
FACTORY_CONTRACT_METADATA_PATH="./abis/Factory.json"
NATIVE_TOKEN_ADDRESS=""

# Rewards (required in production when REWARDS_ENABLED=true)
REWARDS_ENABLED=false
TREASURY_ADDRESS=""
STAKING_CONTRACT_ADDRESS=""
STAKING_CONTRACT_METADATA_PATH="./abis/Staking.json"

# Listing System (fill after deploying listing contracts)
LISTING_MANAGER_CONTRACT_ADDRESS=""
LIQUIDITY_LOCK_CONTRACT_ADDRESS=""
LISTING_RELAYER_STATE_FILE=".state/listing-relayer-state.json"
LISTING_RELAYER_START_BLOCK=
LISTING_RELAYER_REPLAY_BLOCKS=128
LISTING_RELAYER_METRICS_PORT=9471
