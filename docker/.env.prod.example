# ─────────────────────────────────────────────────────────────────
#  Lunex — variáveis de PRODUÇÃO (mainnet)
#  Copie para .env.prod e preencha TODOS os valores antes do deploy
#  NUNCA commite este arquivo com valores reais
#
#  Uso:
#    docker compose -f docker/docker-compose.prod.yml --env-file docker/.env.prod up -d
#
#  Para sandbox (testnet), use também:
#    docker compose -f docker/docker-compose.prod.yml \
#      -f docker/docker-compose.sandbox.yml \
#      --env-file docker/.env.prod --env-file docker/.env.sandbox up -d
# ─────────────────────────────────────────────────────────────────

# ── Domínios ──────────────────────────────────────────────────────
DOMAIN_PROD=lunex.lunes.io
DOMAIN_SANDBOX=lunex-sandbox.lunes.io
DOMAIN_TESTNET=sandbox.lunes.io

# ── Banco de dados ────────────────────────────────────────────────
DB_USER=lunex
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Blockchain ────────────────────────────────────────────────────
# IP/host do nó Lunes (roda em Docker separado)
LUNES_WS_URL=wss://ws.lunes.io

# Seed da conta relayer (conta que assina settlements on-chain)
RELAYER_SEED=CHANGE_ME_RELAYER_SEED_PHRASE

# Seed da conta admin da bridge. Obrigatória quando o bridge/asset wrapper estiver habilitado.
BRIDGE_ADMIN_SEED=CHANGE_ME_BRIDGE_ADMIN_SEED_PHRASE

# ── Contratos deployados (mainnet) ───────────────────────────────
SPOT_CONTRACT_ADDRESS=CHANGE_ME_SPOT_CONTRACT_ADDRESS
SPOT_CONTRACT_METADATA_PATH=./abis/Spot.json
FACTORY_CONTRACT_ADDRESS=CHANGE_ME_FACTORY_CONTRACT_ADDRESS
FACTORY_CONTRACT_METADATA_PATH=./abis/Factory.json
NATIVE_TOKEN_ADDRESS=CHANGE_ME_NATIVE_TOKEN_ADDRESS

# Rewards on-chain. Se REWARDS_ENABLED=true, TREASURY_ADDRESS e
# STAKING_CONTRACT_ADDRESS são obrigatórios no boot da API.
REWARDS_ENABLED=false
TREASURY_ADDRESS=
STAKING_CONTRACT_ADDRESS=
STAKING_CONTRACT_METADATA_PATH=./abis/Staking.json

REACT_APP_FACTORY_CONTRACT=CHANGE_ME_FACTORY_CONTRACT_ADDRESS
REACT_APP_ROUTER_CONTRACT=CHANGE_ME_ROUTER_CONTRACT_ADDRESS
REACT_APP_STAKING_CONTRACT=CHANGE_ME_STAKING_CONTRACT_ADDRESS
REACT_APP_REWARDS_CONTRACT=CHANGE_ME_REWARDS_CONTRACT_ADDRESS

# ── Tokens (mainnet) ──────────────────────────────────────────────
WLUNES_ADDRESS=CHANGE_ME_WLUNES_ADDRESS
LUSDT_ADDRESS=CHANGE_ME_LUSDT_ADDRESS
LBTC_ADDRESS=CHANGE_ME_LBTC_ADDRESS
LETH_ADDRESS=CHANGE_ME_LETH_ADDRESS
GMC_ADDRESS=CHANGE_ME_GMC_ADDRESS
LUP_ADDRESS=CHANGE_ME_LUP_ADDRESS

# ── RPC mainnet ───────────────────────────────────────────────────
REACT_APP_RPC_MAINNET=wss://ws.lunes.io

# Public URL da spot-api usada no bundle do frontend. Obrigatória e não pode
# apontar para localhost/rede privada em builds de produção.
# Mesma origem do DEX: nginx.prod.conf serve /api e /ws em lunex.lunes.io e
# a CSP (connect-src) só libera essa origem. Um host api.* separado não tem
# server block no nginx (cai no catch-all 444) e seria bloqueado pela CSP.
REACT_APP_SPOT_API_URL=https://lunex.lunes.io

# ── Admin (Next.js) ───────────────────────────────────────────────
# Gere com: openssl rand -base64 32
ADMIN_SECRET=CHANGE_ME_SPOT_API_ADMIN_SECRET
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET
NEXTAUTH_URL=https://lunex.lunes.io/admin

# ── Spot API read sessions ────────────────────────────────────────
# HMAC secret for one-signature read sessions (>= 32 chars, != ADMIN_SECRET)
# Gere com: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# ── CORS e domínio ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://lunex.lunes.io,https://lunex-sandbox.lunes.io
ALLOWED_WS_ORIGINS=https://lunex.lunes.io,https://lunex-sandbox.lunes.io

# ── Redis ─────────────────────────────────────────────────────────
# Em produção o Redis roda no container interno com senha obrigatória
# (IN-04). Gere com: openssl rand -hex 32. Deixe REDIS_URL comentado para
# usar o default do compose (redis://:${REDIS_PASSWORD}@redis:6379).
REDIS_PASSWORD=change-me-redis-password
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
MATCHING_LOCK_TTL_MS=30000
MATCHING_LOCK_WAIT_MS=2000
MATCHING_LOCK_RETRY_MS=50
# Opcional (somente se redis-exporter usar endpoint custom; a senha é REDIS_PASSWORD)
REDIS_EXPORTER_ADDR=redis://redis:6379

# ── Monitoramento (Grafana) ────────────────────────────────────────
# Gere com: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── Backups automáticos (PostgreSQL) ──────────────────────────────
# Off-host/S3 é obrigatório no compose de produção.
BACKUP_S3_BUCKET=CHANGE_ME_BACKUP_BUCKET
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1
BACKUP_RETENTION_DAYS=7
BACKUP_S3_RETENTION_DAYS=30

# ── SubQuery Indexer ───────────────────────────────────────────────
SUBQUERY_ENDPOINT=http://subquery-query:3000
SUBQUERY_ENABLED=false
LUNES_CHAIN_ID=CHANGE_ME_LUNES_MAINNET_GENESIS_HASH
LUNES_START_BLOCK=1

# ── Token Listing System (deploy contratos e preencha) ─────────────
LISTING_MANAGER_CONTRACT_ADDRESS=CHANGE_ME_LISTING_MANAGER_CONTRACT_ADDRESS
LIQUIDITY_LOCK_CONTRACT_ADDRESS=CHANGE_ME_LIQUIDITY_LOCK_CONTRACT_ADDRESS
LISTING_RELAYER_START_BLOCK=
LISTING_RELAYER_REPLAY_BLOCKS=128
LISTING_RELAYER_METRICS_PORT=9471

# ── spot-api production guards (spot-api/src/utils/productionGuards.ts) ──
# Attestor de settlement — seed NOVA, diferente de RELAYER_SEED.
ATTESTOR_SEED=CHANGE_ME_ATTESTOR_SEED_PHRASE
# Genesis da mainnet (0x + 64 hex) — mesmo valor de LUNES_CHAIN_ID.
LUNES_GENESIS_HASH=CHANGE_ME_LUNES_MAINNET_GENESIS_HASH
# Host nu de onde o DEX é servido; vai para a api e para REACT_APP_SIGNING_DOMAIN.
SIGNING_DOMAIN=lunex.lunes.io
# Origem pública https da API (sem caminho).
PUBLIC_API_ORIGIN=https://lunex.lunes.io

# ── Frontend (build args; ver docker-compose.prod.yml) ──────────────────
WALLETCONNECT_PROJECT_ID=
REACT_APP_SPOT_WS_URL=
TURNSTILE_SITE_KEY=
FRONTEND_SENTRY_DSN=
# Se FRONTEND_SENTRY_DSN estiver setado: origem EXATA do ingest do DSN
# (ex.: https://o123456.ingest.us.sentry.io) → entra no CSP connect-src do
# nginx (LUNEX_CSP_SENTRY_ORIGIN). Vazio = sem Sentry.
SENTRY_INGEST_ORIGIN=
MAINTENANCE=false
FEATURE_MARGIN=false
LISTING_FEE_TOKEN=
COPY_VAULT_CONTRACT=
# Opcionais (LUNES); vazio = defaults do frontend (0.01 / 1)
NATIVE_EXISTENTIAL_DEPOSIT_LUNES=
NATIVE_FEE_BUFFER_LUNES=
