# ─────────────────────────────────────────────────────────────────
#  Lunex DEX — Testnet Environment (Public Lunes Testnet)
#  Copie para .env.testnet e preencha todos os valores
#
#  NUNCA commite .env.testnet com valores reais!
# ─────────────────────────────────────────────────────────────────

# ── Banco de dados ────────────────────────────────────────────────
DB_USER=lunex
DB_PASSWORD=change-me-strong-password

# ── Blockchain — Lunes Testnet Pública ────────────────────────────
# Não precisa de nó local — conecta direto na testnet pública
LUNES_TESTNET_WS_URL=wss://testnet.lunes.io

# ── Relayer (carteira dedicada para testnet) ──────────────────────
# NUNCA use a seed de produção aqui
# Gere com: subkey generate --scheme sr25519
RELAYER_SEED=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12
BRIDGE_ADMIN_SEED=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# ── Segurança ─────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
ADMIN_SECRET=change-me-admin-secret
# Read-session HMAC secret (>= 32 chars, diferente de ADMIN_SECRET): openssl rand -base64 48
SESSION_SECRET=change-me-session-secret-at-least-32-characters
NEXTAUTH_SECRET=change-me-nextauth-secret

# Chave de atestação (2-of-2 settlement) — diferente de RELAYER_SEED
ATTESTOR_SEED=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# ── Redis (IN-04) — obrigatório; openssl rand -hex 32 ─────────────
REDIS_PASSWORD=change-me-redis-password

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://lunex-sandbox.lunes.io
ALLOWED_WS_ORIGINS=https://lunex-sandbox.lunes.io

# ── Domínio / TLS (nginx.testnet.conf é template) ─────────────────
TESTNET_DOMAIN=lunex-sandbox.lunes.io
# Nome do diretório em /etc/letsencrypt/live/<nome>/ (certbot --cert-name)
TESTNET_CERT_NAME=lunex-sandbox.lunes.io
# Quem pode abrir /admin (VPN/escritório). 127.0.0.1/32 = ninguém de fora.
ADMIN_ALLOW_CIDR=127.0.0.1/32
# Origens extras para connect-src da CSP, separadas por espaço (ex.: o host
# exato de ingest do Sentry). Vazio por padrão.
CSP_EXTRA_CONNECT=
# Origem EXATA do ingest do FRONTEND_SENTRY_DSN (ex.:
# https://o123456.ingest.us.sentry.io) → CSP connect-src. Vazio = sem Sentry.
SENTRY_INGEST_ORIGIN=
# Origem de TESTNET_FAUCET_URL quando ela NÃO é o próprio TESTNET_DOMAIN
# (mesma origem já é coberta pela CSP). Vazio por padrão.
TESTNET_FAUCET_ORIGIN=

# ── URLs ──────────────────────────────────────────────────────────
NEXTAUTH_URL=https://lunex-sandbox.lunes.io/admin
# Mesma origem do DEX: o nginx do testnet serve /api e /ws neste host, e a
# CSP só libera essa origem (um host api.* separado seria bloqueado).
TESTNET_SPOT_API_URL=https://lunex-sandbox.lunes.io
TESTNET_SPOT_WS_URL=wss://lunex-sandbox.lunes.io/ws
PUBLIC_API_ORIGIN=https://lunex-sandbox.lunes.io
# Origem BASE do faucet (o client do DEX anexa /faucet/config e faz POST
# /faucet). Mesma origem: o nginx do testnet serve /faucet e /faucet/*.
# ATENÇÃO: não inclua "/faucet" aqui (viraria /faucet/faucet/config).
TESTNET_FAUCET_URL=https://lunex-sandbox.lunes.io

# ── Rede ──────────────────────────────────────────────────────────
# Genesis hash da testnet (0x + 64 hex): obrigatório (API, frontend e SubQuery)
TESTNET_GENESIS_HASH=0xCHANGE_ME_TESTNET_GENESIS_HASH
TESTNET_SUBQUERY_START_BLOCK=1

# ── Frontend (públicos por design, embutidos no bundle) ───────────
WALLETCONNECT_PROJECT_ID=CHANGE_ME_WALLETCONNECT_PROJECT_ID
TURNSTILE_SITE_KEY=CHANGE_ME_TURNSTILE_SITE_KEY
FRONTEND_SENTRY_DSN=
MAINTENANCE=false
FEATURE_MARGIN=false
TESTNET_CHAIN_NAME=Lunes Testnet
# Versão exibida/telemetria (default: IMAGE_TAG ou "dev")
FRONTEND_VERSION=
# Opcionais (LUNES); vazio = defaults do frontend (0.01 / 1)
NATIVE_EXISTENTIAL_DEPOSIT_LUNES=
NATIVE_FEE_BUFFER_LUNES=

# ── Faucet (contrato completo em faucet/.env.example) ─────────────
# Carteira dedicada e financiada da testnet (NUNCA //Alice / seed de mainnet).
# Obrigatória: o faucet recusa subir sem ela fora de dev.
FAUCET_SEED=CHANGE_ME_FAUCET_TREASURY_MNEMONIC
# Obrigatório fora de dev
TURNSTILE_SECRET=CHANGE_ME_TURNSTILE_SECRET
FAUCET_CORS_ORIGINS=https://lunex-sandbox.lunes.io
FAUCET_DRIP_AMOUNT=1000000000000
FAUCET_COOLDOWN_MINUTES=300
FAUCET_IP_MAX_PER_WINDOW=3
FAUCET_IP_WINDOW_MINUTES=1440
# Beta comunitário: ~250 testers ativos/dia × ≤2 drips ≈ 500/dia
# (cooldown 300 min por endereço, 3 drips/IP/24h). 10.000 LUNES/drip →
# ≤5M LUNES de teste/dia: financie FAUCET_SEED para isso ou reduza.
FAUCET_DAILY_LIMIT=500
FAUCET_GLOBAL_RATE_PER_MINUTE=20
FAUCET_TOKENS=LUSDT,LBTC,LETH,GMC,LUP
FAUCET_PUBLIC_RPC=https://sandbox.lunes.io

# ── Contratos testnet (preencher após deploy) ─────────────────────
TESTNET_SPOT_CONTRACT=CHANGE_ME_TESTNET_SPOT_CONTRACT
TESTNET_SPOT_CONTRACT_METADATA_PATH=./abis/Spot.json
TESTNET_FACTORY_CONTRACT=CHANGE_ME_TESTNET_FACTORY_CONTRACT
TESTNET_ROUTER_CONTRACT=CHANGE_ME_TESTNET_ROUTER_CONTRACT
TESTNET_STAKING_CONTRACT=CHANGE_ME_TESTNET_STAKING_CONTRACT
TESTNET_REWARDS_CONTRACT=CHANGE_ME_TESTNET_REWARDS_CONTRACT
TESTNET_LISTING_MANAGER_CONTRACT=CHANGE_ME_TESTNET_LISTING_MANAGER_CONTRACT
TESTNET_LISTING_FEE_TOKEN=CHANGE_ME_TESTNET_LISTING_FEE_TOKEN
TESTNET_COPY_VAULT_CONTRACT=CHANGE_ME_TESTNET_COPY_VAULT_CONTRACT
TESTNET_NATIVE_TOKEN_ADDRESS=CHANGE_ME_TESTNET_NATIVE_TOKEN_ADDRESS
TESTNET_TREASURY_ADDRESS=CHANGE_ME_TESTNET_TREASURY_ADDRESS

# Rewards on-chain. Se REWARDS_ENABLED=true, TESTNET_TREASURY_ADDRESS e
# TESTNET_STAKING_CONTRACT precisam estar preenchidos.
REWARDS_ENABLED=false
STAKING_CONTRACT_METADATA_PATH=./abis/Staking.json

# ── Tokens testnet (preencher após deploy) ────────────────────────
TESTNET_WLUNES_ADDRESS=CHANGE_ME_TESTNET_WLUNES_ADDRESS
TESTNET_LUSDT_ADDRESS=CHANGE_ME_TESTNET_LUSDT_ADDRESS
TESTNET_LBTC_ADDRESS=CHANGE_ME_TESTNET_LBTC_ADDRESS
TESTNET_LETH_ADDRESS=CHANGE_ME_TESTNET_LETH_ADDRESS
TESTNET_GMC_ADDRESS=CHANGE_ME_TESTNET_GMC_ADDRESS
TESTNET_LUP_ADDRESS=CHANGE_ME_TESTNET_LUP_ADDRESS
