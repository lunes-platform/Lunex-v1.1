# ── Stage 1: Build ──
FROM node:20-alpine AS builder
WORKDIR /app

# Build-time args — baked into the Vite bundle (loadEnv reads REACT_APP_*
# from process.env). Keep in sync with `grep -rhoE "REACT_APP_[A-Z0-9_]+" src`.
ARG REACT_APP_NETWORK=testnet
ARG REACT_APP_SPOT_API_URL=""
ARG REACT_APP_RPC_TESTNET=wss://testnet.lunes.io
ARG REACT_APP_RPC_MAINNET=wss://ws.lunes.io
ARG REACT_APP_FACTORY_CONTRACT=""
ARG REACT_APP_ROUTER_CONTRACT=""
ARG REACT_APP_STAKING_CONTRACT=""
ARG REACT_APP_REWARDS_CONTRACT=""
ARG REACT_APP_TOKEN_WLUNES=""
ARG REACT_APP_TOKEN_LUSDT=""
ARG REACT_APP_TOKEN_LBTC=""
ARG REACT_APP_TOKEN_LETH=""
ARG REACT_APP_TOKEN_GMC=""
ARG REACT_APP_TOKEN_LUP=""
ARG REACT_APP_ENABLE_STAKING=true
ARG REACT_APP_ENABLE_REWARDS=true
ARG REACT_APP_DEV_MODE=false
ARG REACT_APP_API_URL=""
ARG REACT_APP_SPOT_WS_URL=""
ARG REACT_APP_GENESIS_HASH=""
ARG REACT_APP_LUNES_GENESIS_HASH=""
ARG REACT_APP_WALLETCONNECT_PROJECT_ID=""
ARG REACT_APP_WNATIVE_CONTRACT=""
ARG REACT_APP_LISTING_MANAGER_CONTRACT=""
ARG REACT_APP_LISTING_FEE_TOKEN=""
ARG REACT_APP_COPY_VAULT_CONTRACT=""
ARG REACT_APP_SPOT_SETTLEMENT_CONTRACT=""
ARG REACT_APP_FAUCET_URL=""
ARG REACT_APP_TURNSTILE_SITE_KEY=""
ARG REACT_APP_SENTRY_DSN=""
ARG REACT_APP_MAINTENANCE=false
ARG REACT_APP_VERSION=dev
ARG REACT_APP_CHAIN_NAME=""
ARG REACT_APP_FEATURE_MARGIN=false
ARG REACT_APP_SIGNING_DOMAIN=""
ARG REACT_APP_NATIVE_EXISTENTIAL_DEPOSIT_LUNES=""
ARG REACT_APP_NATIVE_FEE_BUFFER_LUNES=""
ARG LUNEX_FRONTEND_STRICT_BUILD=true

ENV REACT_APP_NETWORK=$REACT_APP_NETWORK \
    REACT_APP_SPOT_API_URL=$REACT_APP_SPOT_API_URL \
    REACT_APP_RPC_TESTNET=$REACT_APP_RPC_TESTNET \
    REACT_APP_RPC_MAINNET=$REACT_APP_RPC_MAINNET \
    REACT_APP_FACTORY_CONTRACT=$REACT_APP_FACTORY_CONTRACT \
    REACT_APP_ROUTER_CONTRACT=$REACT_APP_ROUTER_CONTRACT \
    REACT_APP_STAKING_CONTRACT=$REACT_APP_STAKING_CONTRACT \
    REACT_APP_REWARDS_CONTRACT=$REACT_APP_REWARDS_CONTRACT \
    REACT_APP_TOKEN_WLUNES=$REACT_APP_TOKEN_WLUNES \
    REACT_APP_TOKEN_LUSDT=$REACT_APP_TOKEN_LUSDT \
    REACT_APP_TOKEN_LBTC=$REACT_APP_TOKEN_LBTC \
    REACT_APP_TOKEN_LETH=$REACT_APP_TOKEN_LETH \
    REACT_APP_TOKEN_GMC=$REACT_APP_TOKEN_GMC \
    REACT_APP_TOKEN_LUP=$REACT_APP_TOKEN_LUP \
    REACT_APP_ENABLE_STAKING=$REACT_APP_ENABLE_STAKING \
    REACT_APP_ENABLE_REWARDS=$REACT_APP_ENABLE_REWARDS \
    REACT_APP_DEV_MODE=$REACT_APP_DEV_MODE \
    REACT_APP_API_URL=$REACT_APP_API_URL \
    REACT_APP_SPOT_WS_URL=$REACT_APP_SPOT_WS_URL \
    REACT_APP_GENESIS_HASH=$REACT_APP_GENESIS_HASH \
    REACT_APP_LUNES_GENESIS_HASH=$REACT_APP_LUNES_GENESIS_HASH \
    REACT_APP_WALLETCONNECT_PROJECT_ID=$REACT_APP_WALLETCONNECT_PROJECT_ID \
    REACT_APP_WNATIVE_CONTRACT=$REACT_APP_WNATIVE_CONTRACT \
    REACT_APP_LISTING_MANAGER_CONTRACT=$REACT_APP_LISTING_MANAGER_CONTRACT \
    REACT_APP_LISTING_FEE_TOKEN=$REACT_APP_LISTING_FEE_TOKEN \
    REACT_APP_COPY_VAULT_CONTRACT=$REACT_APP_COPY_VAULT_CONTRACT \
    REACT_APP_SPOT_SETTLEMENT_CONTRACT=$REACT_APP_SPOT_SETTLEMENT_CONTRACT \
    REACT_APP_FAUCET_URL=$REACT_APP_FAUCET_URL \
    REACT_APP_TURNSTILE_SITE_KEY=$REACT_APP_TURNSTILE_SITE_KEY \
    REACT_APP_SENTRY_DSN=$REACT_APP_SENTRY_DSN \
    REACT_APP_MAINTENANCE=$REACT_APP_MAINTENANCE \
    REACT_APP_VERSION=$REACT_APP_VERSION \
    REACT_APP_CHAIN_NAME=$REACT_APP_CHAIN_NAME \
    REACT_APP_FEATURE_MARGIN=$REACT_APP_FEATURE_MARGIN \
    REACT_APP_SIGNING_DOMAIN=$REACT_APP_SIGNING_DOMAIN \
    REACT_APP_NATIVE_EXISTENTIAL_DEPOSIT_LUNES=$REACT_APP_NATIVE_EXISTENTIAL_DEPOSIT_LUNES \
    REACT_APP_NATIVE_FEE_BUFFER_LUNES=$REACT_APP_NATIVE_FEE_BUFFER_LUNES

COPY package*.json package-lock.json ./
RUN npm ci --production=false
COPY . .
ENV CI=false
RUN if [ "$LUNEX_FRONTEND_STRICT_BUILD" = "true" ]; then npm run build:prod; else npm run build; fi

# ── Stage 2: Serve with nginx ──
FROM nginx:1.25-alpine AS runner
COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
