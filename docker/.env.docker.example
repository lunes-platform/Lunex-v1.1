# ─────────────────────────────────────────────────────────────────
#  Lunex — Variáveis de ambiente para Docker local (dev)
#  Copie para docker/.env.docker e ajuste os valores
#
#  NUNCA commite este arquivo com valores reais!
# ─────────────────────────────────────────────────────────────────

# ── Blockchain ────────────────────────────────────────────────────
# Nó Lunes local (substrate-contracts-node --dev)
# Dentro do Docker, use host.docker.internal para alcançar o host
LUNES_WS_URL=ws://host.docker.internal:9944

# ── Segurança ─────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
ADMIN_SECRET=change-me-dev-admin-secret
# Read-session HMAC secret (openssl rand -base64 48); vazio = aleatório por processo em dev
SESSION_SECRET=

# Seed da conta relayer. Injete via secrets manager (Doppler). Em dev local
# você pode usar uma conta de desenvolvimento (ex.: //Alice), mas a API
# recusa subir em produção com qualquer chave de dev (IN-05).
RELAYER_SEED=REPLACE_WITH_RELAYER_SEED_FROM_SECRETS_MANAGER

# Seed da bridge. Injete via secrets manager; nunca use chave de dev em produção.
BRIDGE_ADMIN_SEED=REPLACE_WITH_BRIDGE_ADMIN_SEED_FROM_SECRETS_MANAGER

# ── Admin (NextAuth.js) ───────────────────────────────────────────
NEXTAUTH_SECRET=change-me-nextauth-secret-min-32-chars

# ── SubQuery ──────────────────────────────────────────────────────
SUBQUERY_ENDPOINT=http://subquery-query:3000
SUBQUERY_ENABLED=true

# ── Contratos ink! deployed (preencher após deploy) ───────────────
REACT_APP_FACTORY_CONTRACT=
REACT_APP_ROUTER_CONTRACT=
REACT_APP_STAKING_CONTRACT=
REACT_APP_REWARDS_CONTRACT=

WLUNES_ADDRESS=
LUSDT_ADDRESS=
LBTC_ADDRESS=
LETH_ADDRESS=
GMC_ADDRESS=
LUP_ADDRESS=

# ── Feature flags ─────────────────────────────────────────────────
REACT_APP_DEV_MODE=true
SOCIAL_ANALYTICS_ENABLED=true
