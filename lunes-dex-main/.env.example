# Lunex DEX Frontend Configuration
# Copy this file to .env and fill in the values

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
# Available networks: testnet, mainnet
REACT_APP_NETWORK=testnet

# Network RPC endpoints
REACT_APP_RPC_TESTNET=wss://ws-test.lunes.io
REACT_APP_RPC_MAINNET=wss://ws.lunes.io

# ===========================================
# CONTRACT ADDRESSES (Update after deploy)
# ===========================================
# Core DEX Contracts
REACT_APP_FACTORY_CONTRACT=
REACT_APP_ROUTER_CONTRACT=
REACT_APP_WNATIVE_CONTRACT=

# Staking & Rewards Contracts
REACT_APP_STAKING_CONTRACT=
REACT_APP_REWARDS_CONTRACT=

# Token listing (ListingManager). Leave empty to keep on-chain listing
# disabled in the UI. The fee token is read from the contract
# (`lunes_token()`); REACT_APP_LISTING_FEE_TOKEN is only a fallback
# (empty = REACT_APP_TOKEN_WLUNES).
REACT_APP_LISTING_MANAGER_CONTRACT=
REACT_APP_LISTING_FEE_TOKEN=

# Spot orderbook settlement vault (spot_settlement contract). Must be the SAME
# contract spot-api settles against (spot-api SPOT_CONTRACT_ADDRESS, exposed at
# GET /api/v1/balances/settlement) — otherwise the vault panel blocks deposits.
# Empty = vault panel disabled. No hardcoded fallback.
REACT_APP_SPOT_SETTLEMENT_CONTRACT=

# ===========================================
# TOKEN ADDRESSES (Update after deploy)
# ===========================================
# Native and Wrapped tokens
REACT_APP_TOKEN_LUNES=
REACT_APP_TOKEN_WLUNES=

# Bridged tokens
REACT_APP_TOKEN_LBTC=
REACT_APP_TOKEN_LETH=
REACT_APP_TOKEN_LUSDT=

# Ecosystem tokens
REACT_APP_TOKEN_GMC=
REACT_APP_TOKEN_LUP=

# ===========================================
# LP TOKEN ADDRESSES (Created when pools are created)
# ===========================================
REACT_APP_LP_TOKEN_LUNES_USDT=
REACT_APP_LP_TOKEN_LUNES_BTC=
REACT_APP_LP_TOKEN_LUNES_ETH=

# ===========================================
# FEATURE FLAGS
# ===========================================
REACT_APP_ENABLE_STAKING=true
REACT_APP_ENABLE_REWARDS=true
REACT_APP_ENABLE_NATIVE_SWAP=true
# Margin tab in the spot order form. Keep false for the beta: margin collateral
# is DB-only (not backed by the spot vault).
REACT_APP_FEATURE_MARGIN=false

# Development mode (uses mock data when true)
REACT_APP_DEV_MODE=true

# ===========================================
# WALLETCONNECT (phone wallets / desktop app)
# ===========================================
# Project id from https://cloud.walletconnect.com (Reown Cloud). Empty =
# the WalletConnect option is shown disabled ("WalletConnect not configured").
REACT_APP_WALLETCONNECT_PROJECT_ID=
# Optional override: Lunes genesis hash (0x…). Used for the WalletConnect
# `polkadot:<hash prefix>` chain id AND to bind every wallet-signed message to
# this chain. Empty = read from the connected node (api.genesisHash) once
# contractService connects.
REACT_APP_LUNES_GENESIS_HASH=

# ===========================================
# SPOT API
# ===========================================
REACT_APP_SPOT_API_URL=http://localhost:4000
# Spot WebSocket. Empty = derived from REACT_APP_SPOT_API_URL: :4000 → :4001
# (local dev), any other host → wss://<host>/ws (nginx route).
REACT_APP_SPOT_WS_URL=

# ===========================================
# COMMUNITY BETA (testnet UX, telemetry, feedback)
# ===========================================
# Faucet service base URL (faucet/, e.g. https://sandbox.lunes.io). The Faucet
# page + "More > Faucet" link only exist when REACT_APP_NETWORK != mainnet.
REACT_APP_FAUCET_URL=
# Cloudflare Turnstile public site key (CSP: script-src + frame-src
# https://challenges.cloudflare.com). Empty = use the key the faucet exposes.
REACT_APP_TURNSTILE_SITE_KEY=
# Optional Sentry DSN. Empty = Sentry is never loaded (errors still go to
# spot-api /api/v1/telemetry/client-errors). No PII, tracing disabled.
REACT_APP_SENTRY_DSN=
# Build identifier attached to error reports / feedback (e.g. git sha).
REACT_APP_VERSION=
# Expected chain name (system_chain) for the "wrong network" banner. The
# genesis check uses REACT_APP_LUNES_GENESIS_HASH above. Empty = not checked.
REACT_APP_CHAIN_NAME=
# "true" shows the maintenance banner.
REACT_APP_MAINTENANCE=
